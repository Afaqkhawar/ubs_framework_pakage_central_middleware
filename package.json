    "react-phone-input-2": "^2.15.1"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@mui/icons-material": "^6.1.6",
    "@mui/material": "^6.1.6",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "tsup": "^7.2.0",
    "typescript": "^5.9.2"
  },
  "keywords": [
